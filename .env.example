# ═══════════════════════════════════════════════════════════════
# NexQuant — Variables d'environnement (TEMPLATE)
# ═══════════════════════════════════════════════════════════════
# COPIER ce fichier sous le nom ".env" et renseigner vos clés.
# Le fichier .env est dans .gitignore et ne doit JAMAIS être commité.
# ═══════════════════════════════════════════════════════════════
# ==============================================================================
# NEXQUANT SUPERBOT V3 — FICHIER DE CONFIGURATION D'EXEMPLE (.env.example)
# ==============================================================================
# Renommez ce fichier en .env et renseignez vos identifiants MT5 personnels.

# ======================
# SÉLECTION DU BROKER
# ======================
BROKER_TYPE=mt5  # Options: binance, alpaca, mt5
BROKER_TYPE=mt5

# ======================
# CLÉS API BINANCE
# METATRADER 5 (Courtier: Fusion Markets, IC Markets, etc.)
# ======================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true

# ======================
# CLÉS API ALPACA
# ======================
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_USE_PAPER=true

# ======================
# IDENTIFIANTS MT5 (Fusion Markets)
# ======================
MT5_LOGIN=0
MT5_PASSWORD=your_mt5_password_here
MT5_LOGIN=123456
MT5_PASSWORD=votre_mot_de_passe_ici
MT5_SERVER=FusionMarkets-Demo
MT5_PATH=
MT5_PATH=C:\Program Files\MetaTrader 5

# ======================
# INSTRUMENTS PAR BROKER
# PARAMÈTRES DE TRADING
# ======================
INSTRUMENTS_BINANCE=BTC/USDT,ETH/USDT,BNB/USDT
INSTRUMENTS_ALPACA=SPY,QQQ,AAPL,TSLA,MSFT
INSTRUMENTS_MT5=EURUSD,GBPUSD,USDJPY,USDCAD,XAUUSD
# Instruments surveillés et tradés sur MT5 (Forex, Métaux, Énergies)
INSTRUMENTS_MT5=EURUSD,GBPUSD,USDJPY,USDCAD,NZDUSD,EURJPY,GBPJPY,XAUUSD,XAGUSD,WTIUSD,USDCHF,AUDUSD,EURGBP
GRANULARITY=15m
CYCLE_TIME=15

# ======================
# GESTION DU RISQUE
# GESTION DU RISQUE V3
# ======================
RISK_PCT=1.0
MAX_DAILY_LOSS_PCT=2.0
MAX_MONTHLY_LOSS_PCT=5.0
MAX_OPEN_POSITIONS=3
MAX_OPEN_POSITIONS_MT5=3
MAX_OPEN_POSITIONS_BINANCE=2
MAX_OPEN_POSITIONS_ALPACA=2
RISK_PCT=1.0                  # % du capital risqué par trade (ex: 1.0%)
MAX_DAILY_LOSS_PCT=2.0        # % de perte journalière max avant déclenchement du Kill-Switch
MAX_MONTHLY_LOSS_PCT=5.0      # % de perte mensuelle max avant arrêt
MAX_OPEN_POSITIONS=3          # Nombre max de positions simultanées (fallback)
MAX_OPEN_POSITIONS_MT5=3      # Nombre max de positions simultanées sur MT5
MAX_SPREAD_PIPS=2.5           # Spread maximal toléré à l'entrée
MAX_FOREX_CURRENCY_EXPOSURE=2 # Nombre max de positions sur une même devise de base/cotation
ASSET_BLOCK_LOSS_THRESHOLD=0.03
KELLY_FRACTION=0.05
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0
TRAIL_ATR_MULT=2.0
BE_ATR_MULT=1.5
KELLY_FRACTION=0.05           # Fraction Kelly de dimensionnement
SL_ATR_MULT=1.5               # Multiplicateur ATR pour le Stop Loss
TP_ATR_MULT=3.0               # Multiplicateur ATR pour le Take Profit
TRAIL_ATR_MULT=2.0            # Multiplicateur ATR pour le Trailing Stop
BE_ATR_MULT=1.5               # Multiplicateur ATR pour l'activation du Break-Even
BE_DYN_RR=true                # Activation du Break-Even dynamique sur ratio R:R

# ======================
# STRATÉGIE (paramètres globaux)
# STRATÉGIE & SEUILS TECHNIQUES
# ======================
SCORE_MIN=6           # Score minimum global (fallback)
EMA_FAST=9            # EMA rapide global
EMA_SLOW=21           # EMA lente global
EMA_TREND=200         # EMA tendance long-terme
HTF_EMA=50            # EMA timeframe supérieur
D1_EMA=50             # EMA quotidien
W1_EMA=20             # EMA hebdomadaire
RSI_LEN=14
RSI_OB=70
RSI_OS=30
ADX_LEN=14
ADX_TREND=20          # Seuil ADX global

# ======================
# STRATÉGIE PAR CLASSE D'ACTIFS
# ======================
# Chaque actif utilise ses propres paramètres optimisés.
# Laissez les valeurs par défaut si vous débutez.

# Crypto (Binance Futures)
EMA_FAST_CRYPTO=21
EMA_SLOW_CRYPTO=55
ADX_TREND_CRYPTO=25
SCORE_MIN_CRYPTO=7
SL_ATR_MULT_CRYPTO=2.0
TP_ATR_MULT_CRYPTO=4.0

# Forex (MetaTrader 5)
SCORE_MIN=6
SCORE_MIN_FOREX=6
EMA_FAST_FOREX=21
EMA_SLOW_FOREX=55
ADX_TREND_FOREX=20
SCORE_MIN_FOREX=6
SL_ATR_MULT_FOREX=1.5
TP_ATR_MULT_FOREX=3.0
FOREX_NEWS_AVOID_MINUTES=30  # Bloquer ±30min autour de NFP/BCE/FOMC

# ETF/Stocks (Alpaca)
EMA_FAST_STOCK=20
EMA_SLOW_STOCK=50
ADX_TREND_STOCK=20
SCORE_MIN_STOCK=5
SL_ATR_MULT_STOCK=1.5
TP_ATR_MULT_STOCK=3.0
ALLOW_SHORT_STOCK=false  # Mettre à true pour activer les ventes à découvert

# ======================
# NOUVELLES & SENTIMENT
# NOUVELLES, SENTIMENT & MACRO
# ======================
NEWS_ASSETS_BINANCE=BTC,ETH,BNB
NEWS_ASSETS_ALPACA=SPY,QQQ
NEWS_ASSETS_MT5=EUR,USD,GBP,JPY
NEWS_ASSETS_MT5=EUR,USD,GBP,JPY,CAD,CHF,AUD,NZD
NEWS_UPDATE_INTERVAL=300
NEWS_AVOIDANCE_BEFORE=30
NEWS_AVOIDANCE_AFTER=15
NEWS_AVOIDANCE_BEFORE=30      # Minutes d'évitement avant une annonce économique majeure
NEWS_AVOIDANCE_AFTER=15       # Minutes d'évitement après une annonce économique majeure
NEWS_RISK_REDUCTION_FACTOR=0.5
NEWS_HIGH_IMPACT_ONLY=false
FOREX_NEWS_AVOID_MINUTES=30
FEAR_GREED_EXTREME_FEAR=20
FEAR_GREED_EXTREME_GREED=80

# ======================
# LOGGING & MONITORING
# LOGGING & DASHBOARD
# ======================
LOG_LEVEL=INFO
ENABLE_DASHBOARD=true

# ======================
# WEBHOOK (OPTIONNEL)
# TÉLÉMÉTRIE (Optionnel)
# ======================
WEBHOOK_PORT=8080
WEBHOOK_SECRET=change_this_to_a_strong_secret
NEXQUANT_API_URL=http://localhost:8080
NEXQUANT_USER_ID=votre_user_id_telemetrie
NEXQUANT_INGEST_TOKEN=votre_jeton_hmac_secret

# ======================
# TÉLÉMÉTRIE NEXQUANT
# TSMOM (Time-Series Momentum Macro)
# ======================
NEXQUANT_API_URL=http://localhost:8080
NEXQUANT_USER_ID=
NEXQUANT_INGEST_TOKEN=
TSMOM_ENABLED=true
TSMOM_PLACE_ORDERS=true
TSMOM_TARGET_VOL=0.12
TSMOM_MAX_LEVERAGE=1.5
TSMOM_LOOKBACK=3
TSMOM_SKIP=1
